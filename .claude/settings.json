{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve*)",
      "Bash(git push origin produccion*)",
      "Bash(git push * HEAD:produccion*)",
      "Bash(git push * :produccion*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review * --approve*)",
      "PowerShell(git push origin produccion*)",
      "PowerShell(git push * HEAD:produccion*)",
      "PowerShell(git push * :produccion*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push --all*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-production.mjs"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
